# WiFi credentials. Copy this file to .env and set your values.
# .env is gitignored and will not be committed.
# Same keys can be used for harbor-breeze-fan (copy .env to that project).
#
# Leave both empty (or omit them) for BLE-only: WiFi radio off, no HTTP server.
# WiFi and BLE share one 2.4 GHz radio; an unreachable network makes the WiFi
# stack retry association forever and destabilises the BLE link.
WIFI_SSID=your_wifi_ssid
WIFI_PASS=your_wifi_password

# BLE advertising name.
BLE_DEVICE_NAME=IR Blaster

# Shared application token (16–64 characters). Generate a random value, for
# example: openssl rand -hex 24
# Put the same value in the Mac client's config.yaml as ble.auth_token
# (or run: python3 scripts/sync_mac_client.py).
BLE_AUTH_TOKEN=replace_with_a_random_token

# IR receiver (GPIO 10). Set to 0 on transmit-only boards (no KY-022).
# Read at build time by scripts/pio_env_flags.py → -DIR_RECV_ENABLED=…
IR_RECV_ENABLED=1

# How many times to fire each IR send (1–20). Applies to saved-code Send
# (web UI / BLE) and is the default when HTTP/WS omit ?repeat=.
IR_SEND_REPEAT=1
